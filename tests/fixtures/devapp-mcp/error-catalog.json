{
  "categories": [
    {
      "category": "DEVAPP_SLEEPING",
      "code": "DEVAPP_SLEEPING",
      "dispatch_state": "not_dispatched",
      "http_status": 409,
      "message": "the room app is sleeping",
      "next_action": "wait_for_explicit_wake",
      "operation_id": "absent",
      "recoverable": false,
      "suggested_action": "report that the app is sleeping; an explicit human wake control is the only way to start it"
    },
    {
      "category": "DEVAPP_NOT_READY",
      "code": "DEVAPP_NOT_READY",
      "dispatch_state": "not_dispatched",
      "http_status": 409,
      "message": "the room app MCP server is not ready",
      "next_action": "retry_later",
      "operation_id": "absent",
      "recoverable": true,
      "suggested_action": "retry after the app finishes starting"
    },
    {
      "category": "DEVAPP_UNAVAILABLE_PRE_DISPATCH",
      "code": "DEVAPP_UNAVAILABLE",
      "dispatch_state": "not_dispatched",
      "http_status": 503,
      "message": "the room app MCP server is unavailable",
      "next_action": "retry_later",
      "operation_id": "absent",
      "recoverable": true,
      "suggested_action": "retry the same request later"
    },
    {
      "category": "DEVAPP_UNAVAILABLE_UNCERTAIN_DISPATCH",
      "code": "DEVAPP_UNAVAILABLE",
      "dispatch_state": "dispatched_unknown",
      "http_status": 504,
      "message": "the room app MCP server did not answer in time",
      "next_action": "retry_later",
      "operation_id": "absent",
      "recoverable": true,
      "suggested_action": "retry the same zero-effect read",
      "zero_effect_only": true
    },
    {
      "category": "DEVAPP_OPERATION_CONFLICT",
      "code": "CONFLICT",
      "dispatch_state": "not_dispatched",
      "http_status": 409,
      "message": "operation_id is already bound to another request",
      "next_action": "inspect_operation",
      "operation_id": "required",
      "recoverable": false,
      "suggested_action": "inspect the original operation; use its arguments, or choose a new operation_id"
    },
    {
      "category": "DEVAPP_REVISION_CONFLICT",
      "code": "CONFLICT",
      "dispatch_state": "not_dispatched",
      "http_status": 409,
      "message": "Action schema changed after discovery",
      "next_action": "describe_again",
      "operation_id": "absent",
      "recoverable": true,
      "suggested_action": "describe the Action again"
    },
    {
      "category": "DEVAPP_INVALID_ARGUMENTS",
      "code": "INVALID_INPUT",
      "dispatch_state": "not_dispatched",
      "http_status": 400,
      "message": "arguments do not match the registered Action schema",
      "next_action": "correct_arguments",
      "operation_id": "absent",
      "recoverable": true,
      "suggested_action": "describe the Action and correct its arguments"
    },
    {
      "category": "ACTION_NOT_FOUND",
      "code": "NOT_FOUND",
      "dispatch_state": "not_dispatched",
      "http_status": 404,
      "message": "Action is not available in this context",
      "next_action": "none",
      "operation_id": "absent",
      "recoverable": false,
      "suggested_action": "search the selected room's Actions"
    },
    {
      "category": "ACTION_OUTCOME_UNKNOWN",
      "code": "ACTION_OUTCOME_UNKNOWN",
      "dispatch_state": "dispatched_unknown",
      "http_status": 409,
      "message": "the operation may have taken effect; its outcome is unknown",
      "next_action": "inspect_operation",
      "operation_id": "required",
      "recoverable": false,
      "suggested_action": "inspect the original operation_id; do not resubmit it and do not choose a new operation_id"
    },
    {
      "category": "DEVAPP_TOOL_ERROR",
      "code": "DEVAPP_TOOL_ERROR",
      "dispatch_state": "dispatched_failed",
      "http_status": 422,
      "message": "the room app rejected the request",
      "next_action": "correct_arguments",
      "operation_id": "present_for_mutations",
      "recoverable": true,
      "suggested_action": "correct the arguments and try again"
    }
  ],
  "contract_version": "ag2-devapp-mcp/v1",
  "delivery": {
    "core_to_mcp": "http_status_plus_error_envelope",
    "mcp_to_client": "in_band_tool_error",
    "protocol_error_reserved_for": [
      "unknown_tool",
      "malformed_params"
    ]
  },
  "dispatch_states": [
    "not_dispatched",
    "dispatched_unknown",
    "dispatched_failed",
    "dispatched_completed"
  ],
  "envelope": {
    "devapp_additive": [
      "details"
    ],
    "note": "DevApp diagnostics live in details because the MCP facade's _error() forwards only code/message/recoverable/suggested_action/correlation_id/details.",
    "required": [
      "code",
      "message",
      "recoverable",
      "suggested_action",
      "correlation_id"
    ],
    "source": "services/core-api/services/errors.py envelope()"
  },
  "guarantees": {
    "auth_failure_is_always_pre_dispatch": true,
    "no_automatic_mutation_replay": true,
    "no_automatic_wake": true
  },
  "next_actions": [
    "correct_arguments",
    "describe_again",
    "inspect_operation",
    "none",
    "retry_later",
    "wait_for_explicit_wake"
  ],
  "operation_binding": {
    "caller_supplied_operation_id": "required_for_mutations",
    "core_fingerprint": [
      "actor",
      "room_id",
      "action",
      "arguments_digest",
      "action_revision"
    ],
    "duplicate_rule": "a second execute whose fingerprint matches a record inside the retention window is a duplicate even under a different operation_id; Core replays the stored outcome and never dispatches again",
    "recommended_derivation": "sha256 over actor + room_id + action + canonical arguments + the caller task id, so a retried task reuses one id"
  },
  "publication_diagnostics": [
    "DEVAPP_CATALOG_TOO_LARGE",
    "DEVAPP_DISCOVERY_INCOMPLETE",
    "DEVAPP_MANIFEST_INVALID",
    "DEVAPP_READY_FALSE",
    "DEVAPP_TOOL_EFFECT_UNKNOWN",
    "DEVAPP_TOOL_NAME_COLLISION",
    "DEVAPP_TOOL_NAME_INVALID",
    "DEVAPP_TOOL_NAME_RESERVED",
    "DEVAPP_TOOL_SCHEMA_UNSUPPORTED"
  ],
  "retry_decision": {
    "not_a_signal": "recoverable",
    "resend_execute_allowed_when": [
      "not_dispatched"
    ],
    "resend_execute_forbidden_when": [
      "dispatched_unknown",
      "dispatched_failed",
      "dispatched_completed"
    ],
    "signal": "details.dispatch_state"
  }
}
